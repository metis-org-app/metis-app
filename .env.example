# Base URL of metis-api. Only the Next.js server talks to it; the browser never does.
METIS_API_URL=http://localhost:5151

# Public URL of this app (scheme and host, no path). Links students open, such as /unirse/<code>, are built from it
# on the server, so they are ready in the first render.
APP_URL=http://localhost:3000

# Secret shared with metis-api (ClientIp__ProxySecret there, same value), sent with the client IP so metis-api's rate
# limits see each student. Required in production; optional in development, where metis-api trusts X-Forwarded-For
# from loopback instead. Generate it with: openssl rand -base64 32
METIS_PROXY_SECRET=
